{
  "config_version": 1,
  "motion": {
    "active_profile": {
      "sampling_frequency_hz": 400,
      "gyroscope": {
        "range_degrees_per_second": 2000
      }
    },
    "inactive_profile": "restore_previous",
    "idle_timeout_seconds": 60,
    "filter": {
      "sensitivity": 1350,
      "deadband": 0.012,
      "smoothingMs": 18,
      "forwardAxis": [1, 0, 0]
    }
  },
  "output": {
    "movement_rate_hz": 80
  },
  "ui": {
    "swap_click_buttons": false,
    "sampling_frequency_options_hz": [50, 100, 200, 400, 800]
  },
  "bluetooth": {
    "ownership": "always"
  }
}
