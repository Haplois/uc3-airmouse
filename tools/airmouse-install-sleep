#!/usr/bin/env python3
"""Install orderly sensor and owned-Bluetooth shutdown/resume around system sleep."""
import argparse
from pathlib import Path
import re
import shlex
import subprocess

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--host', default='root@10.0.10.51')
args = parser.parse_args()
if not re.fullmatch(r'[a-z_][a-z0-9_-]*@[A-Za-z0-9][A-Za-z0-9.-]*', args.host):
    parser.error('Expected user@host')
root = Path(__file__).resolve().parents[1]
ssh = ['ssh','-o','BatchMode=yes','-o','ConnectTimeout=8',args.host]
for source, target in [('deploy/sleep.sh','/mnt/data/airmouse/sleep.sh'),
                       ('deploy/airmouse-sleep.service','/etc/systemd/system/airmouse-sleep.service')]:
    subprocess.run(ssh + [f'umask 022; cat > {shlex.quote(target)}.new && mv {shlex.quote(target)}.new {shlex.quote(target)}'],
                   input=(root/source).read_bytes(),check=True)
subprocess.run(ssh+['systemctl daemon-reload && systemctl enable airmouse-sleep.service'],check=True)
print('Sleep recovery installed; no service was restarted.')
