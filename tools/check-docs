#!/usr/bin/env python3
"""Check Markdown fences and local inline links, including heading fragments.

Run `python3 tools/check-docs` from any directory. Uses the repository's inline
link syntax; does not fetch external URLs or inspect links inside code blocks.
"""

from pathlib import Path
import re
import subprocess
import sys
from urllib.parse import unquote, urlsplit


ROOT = Path(__file__).resolve().parent.parent


def prose(path):
    fence = None
    for number, line in enumerate(path.read_text().splitlines(), 1):
        marker = re.match(r"^\s{0,3}(`{3,}|~{3,})(.*)$", line)
        if marker:
            run, tail = marker.groups()
            if fence is None:
                fence = (run, number)
            elif run[0] == fence[0][0] and len(run) >= len(fence[0]) and not tail.strip():
                fence = None
        elif fence is None:
            yield number, line
    if fence:
        raise ValueError(f"{path.relative_to(ROOT)}:{fence[1]}: unclosed code fence")


def headings(lines):
    result = set()
    for _, line in lines:
        match = re.match(r"^#{1,6}\s+(.+?)(?:\s+#+)?$", line)
        if match:
            base = re.sub(r"[^\w\- ]", "", match[1].lower()).replace(" ", "-")
            slug = base
            suffix = 0
            while slug in result:
                suffix += 1
                slug = f"{base}-{suffix}"
            result.add(slug)
    return result


def main():
    names = subprocess.check_output(
        ["git", "ls-files", "--cached", "--others", "--exclude-standard", "-z", "*.md"],
        cwd=ROOT,
    ).decode().split("\0")
    documents = {}
    errors = []
    for name in sorted(set(names) - {""}):
        path = ROOT / name
        if not path.is_file():
            continue
        try:
            documents[path.resolve()] = list(prose(path))
        except ValueError as error:
            errors.append(str(error))
    anchors = {path: headings(lines) for path, lines in documents.items()}
    checked = 0
    for path, lines in documents.items():
        by_number = dict(lines)
        source = "\n".join(by_number.get(n, "") for n in range(1, max(by_number, default=0) + 1))
        source = re.sub(r"(`+).*?\1", lambda m: re.sub(r"[^\n]", " ", m[0]), source, flags=re.S)
        for match in re.finditer(r"\[[^\]]*\]\(([^\s)]+)\)", source):
            link = urlsplit(match[1].strip("<>"))
            if link.scheme or link.netloc:
                continue
            checked += 1
            target = (path.parent / unquote(link.path)).resolve() if link.path else path
            number = source.count("\n", 0, match.start()) + 1
            location = f"{path.relative_to(ROOT)}:{number}"
            if not target.exists():
                errors.append(f"{location}: missing link target {match[1]}")
            elif link.fragment and target in anchors and unquote(link.fragment) not in anchors[target]:
                errors.append(f"{location}: missing heading {match[1]}")
    if errors:
        print("\n".join(errors), file=sys.stderr)
        return 1
    print(f"Checked {len(documents)} Markdown files and {checked} local links.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
