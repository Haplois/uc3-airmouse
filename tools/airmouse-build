#!/usr/bin/env python3
"""Build a self-contained Node.js release. No package manager runs on the remote."""
import hashlib
import gzip
import pathlib
import subprocess
import tarfile

root = pathlib.Path(__file__).resolve().parent.parent
subprocess.run(['npm', 'ci', '--omit=dev', '--ignore-scripts', '--no-audit', '--no-fund'], cwd=root, check=True)
files = sorted(p for directory in ['runtime', 'deploy', 'config', 'node_modules/ws'] for p in (root / directory).rglob('*') if p.is_file())
files += [root / 'package.json', root / 'package-lock.json']
digest = hashlib.sha256()
for p in files:
    digest.update(str(p.relative_to(root)).encode())
    digest.update(p.read_bytes())
release = digest.hexdigest()[:16]
(root / 'dist').mkdir(exist_ok=True)
archive = root / 'dist' / f'airmouse-{release}.tar.gz'
with archive.open('wb') as destination:
    with gzip.GzipFile(filename='', mode='wb', fileobj=destination, mtime=0) as compressed:
        with tarfile.open(fileobj=compressed, mode='w') as tar:
            for p in files:
                info = tar.gettarinfo(str(p), arcname=str(p.relative_to(root)))
                info.uid = info.gid = 0
                info.uname = info.gname = ''
                info.mtime = 0
                # Modes come from the release contract, not the build host's umask: the service user must read everything.
                info.mode = 0o755 if info.mode & 0o100 else 0o644
                with p.open('rb') as f:
                    tar.addfile(info, f)
print(archive)
