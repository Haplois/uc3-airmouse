#!/usr/bin/env python3
"""Send bounded test keys through Remote 3 Bluetooth, restoring its runtime."""
import argparse
import json
from pathlib import Path
import runpy
import subprocess

SEND = r'''
import { HidOutput } from '/mnt/data/airmouse/current/runtime/hid-output.mjs';
import { setTimeout as delay } from 'node:timers/promises';
const output = new HidOutput();
output.start();
try {
  let target;
  for (let i = 0; i < 300; i++) {
    target = output.targets.find(t => t.bluetooth_name === '[LG] webOS TV OLED77G3PSA');
    if (target && output.ready(target.id)) break;
    if (target && i === 20) await output.reconnect();
    await delay(50);
  }
  if (!target || !output.ready(target.id)) throw new Error('LG TV is not ready');
  for (const action of ACTIONS) {
    await output[action.type](target.id, action.key);
    await delay(400);
    console.log(JSON.stringify(action));
  }
} finally { output.close(); }
'''

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--remote', required=True)
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument('--keys', nargs='+', choices=['home', 'up', 'down', 'left', 'right', 'ok', 'back',
        'quick_settings', 'all_settings', 'input_picker', 'hdmi1', 'netflix', 'youtube', 'steam_machine'])
    group.add_argument('--media', nargs='+', choices=['volume_up', 'volume_down', 'mute', 'play_pause', 'stop'])
    args = parser.parse_args()
    values = args.keys or args.media
    if len(values) > 20:
        parser.error('At most 20 test presses per run')
    actions = [{'type': 'key' if args.keys else 'media', 'key': key} for key in values]
    TV = runpy.run_path(str(Path(__file__).with_name('airmouse-lg-deploy-receiver')))['TV']
    remote = TV(args.remote)
    remote.ssh('systemctl is-active airmouse.service')
    try:
        remote.ssh('systemctl stop airmouse.service')
        print(remote.ssh('node --input-type=module -', data=SEND.replace('ACTIONS', json.dumps(actions)).encode()))
    except subprocess.CalledProcessError as error:
        print(error.stdout.decode())
        print(error.stderr.decode())
        raise SystemExit(error.returncode)
    finally:
        remote.ssh('systemctl start airmouse.service')

if __name__ == '__main__':
    main()
