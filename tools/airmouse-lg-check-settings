#!/usr/bin/env python3
"""Open each TV settings panel over Bluetooth and check TV launch events.

Temporarily stops the pointer runtime to use its single-client Bluetooth socket,
then restores it. Leaves All Settings open. Does not verify rendered pixels.
"""
import argparse
import json
from pathlib import Path
import runpy
import shlex
import subprocess
import time


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--tv', required=True)
    parser.add_argument('--remote', required=True)
    args = parser.parse_args()
    TV = runpy.run_path(str(Path(__file__).with_name('airmouse-lg-deploy-receiver')))['TV']
    tv, remote = TV(args.tv), TV(args.remote)
    for key, app in [('quick_settings', 'com.webos.app.quicksettings'),
                     ('input_picker', 'com.webos.app.quickinputpicker'),
                     ('all_settings', 'com.palm.app.settings')]:
        script = '''
import { HidOutput } from '/mnt/data/airmouse/current/runtime/hid-output.mjs';
import { setTimeout as delay } from 'node:timers/promises';
const output = new HidOutput();
output.start();
try {
  let target;
  for (let i = 0; i < 100; i++) {
    target = output.targets.find(t => t.bluetooth_name === '[LG] webOS TV OLED77G3PSA');
    if (target && output.ready(target.id)) break;
    await delay(50);
  }
  if (!target || !output.ready(target.id)) throw new Error('LG TV is not ready');
  await output.key(target.id, KEY);
} finally { output.close(); }
'''.replace('KEY', json.dumps(key))
        remote.ssh('systemctl is-active airmouse.service')
        observer = None
        try:
            remote.ssh('systemctl stop airmouse.service')
            remote.ssh('node --input-type=module -',
                       data=script.replace(json.dumps(key), json.dumps('home')).encode())
            time.sleep(.5)
            observer = subprocess.Popen(['ssh', '-tt', '-o', 'ConnectTimeout=5', tv.host,
                '/usr/bin/luna-send -n 20 -w 8000 '
                'luna://com.webos.service.applicationmanager/getAppLifeStatus '
                + shlex.quote('{"subscribe":true}')],
                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
            if not json.loads(observer.stdout.readline()).get('subscribed'):
                raise RuntimeError('TV lifecycle observer did not subscribe')
            remote.ssh('node --input-type=module -', data=script.encode())
            output, _ = observer.communicate(timeout=15)
            events = [json.loads(line) for line in output.splitlines() if line.startswith('{')]
            if not any(event.get('appId') == app and event.get('status') in ('launching', 'foreground')
                       for event in events):
                raise RuntimeError(key + ': TV did not report the expected launch: ' + output)
            print(key + ': TV launch confirmed ' + app, flush=True)
        finally:
            if observer and observer.poll() is None:
                observer.terminate()
                observer.communicate(timeout=5)
            remote.ssh('systemctl start airmouse.service')


if __name__ == '__main__':
    main()
