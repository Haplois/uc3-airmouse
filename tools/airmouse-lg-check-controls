#!/usr/bin/env python3
"""Exercise Remote 3 Bluetooth controls and check their TV-side effects.

Restores volume, mute and the pointer runtime. Leaves Netflix open. Media checks
verify Play/Pause and Stop key edges, not playback in every installed app.
"""
import argparse
import json
from pathlib import Path
import runpy
import shlex
import subprocess
import time

OBSERVE = r'''
import json, os, select, struct, time
from pathlib import Path
device = next(p for p in Path('/sys/class/input').glob('event*/device/name')
              if p.read_text().strip() == 'Smart Remote RCU Input')
fd = os.open('/dev/input/' + device.parts[-3], os.O_RDONLY | os.O_NONBLOCK)
print('READY', flush=True)
events = []
deadline = time.monotonic() + 12
try:
    while time.monotonic() < deadline and len(events) < 4:
        if select.select([fd], [], [], .2)[0]:
            data = os.read(fd, 4096)
            for offset in range(0, len(data), 16):
                _, _, kind, key, value = struct.unpack_from('<IIHHi', data, offset)
                if kind == 1 and key in (164, 128):
                    events.append([key, value])
finally:
    os.close(fd)
print(json.dumps(events), flush=True)
'''


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--tv', required=True)
    parser.add_argument('--remote', required=True)
    args = parser.parse_args()
    folder = Path(__file__).parent
    TV = runpy.run_path(str(folder / 'airmouse-lg-deploy-receiver'))['TV']
    sender = runpy.run_path(str(folder / 'airmouse-lg-send-control'))['SEND']
    tv, remote = TV(args.tv), TV(args.remote)

    def api(service, method, body=None):
        result = json.loads(tv.ssh('luna-send -n 1 -w 3000 luna://' + service + '/' + method
                                  + ' ' + shlex.quote(json.dumps(body or {})), tty=True))
        if result.get('returnValue') is not True:
            raise RuntimeError(str(result))
        return result

    def send(kind, *keys):
        remote.ssh('node --input-type=module -', data=sender.replace('ACTIONS', json.dumps(
            [{'type': kind, 'key': key} for key in keys])).encode())

    audio = 'com.webos.audio'
    apps = 'com.webos.service.applicationmanager'
    before = api(audio, 'getVolume')
    observer = None
    remote.ssh('systemctl is-active airmouse.service')
    try:
        remote.ssh('systemctl stop airmouse.service')
        api(audio, 'setVolume', {'volume': 20})
        api(audio, 'setMuted', {'muted': False})
        for key, expected in [('volume_up', 21), ('volume_down', 20)]:
            send('media', key)
            actual = api(audio, 'getVolume')['volume']
            if actual != expected:
                raise RuntimeError(key + ': expected ' + str(expected) + ', got ' + str(actual))
            print('PASS ' + key, flush=True)
        for expected in (True, False):
            send('media', 'mute')
            if api(audio, 'getVolume')['muteStatus'] is not expected:
                raise RuntimeError('Mute did not toggle to ' + str(expected))
        print('PASS mute toggles both ways', flush=True)
        api(apps, 'launch', {'id': 'com.webos.app.hdmi2'})
        time.sleep(2)
        for key, app in [('hdmi1', 'com.webos.app.hdmi1'), ('youtube', 'youtube.leanback.v4'),
                         ('netflix', 'netflix')]:
            send('key', key)
            for _ in range(30):
                if api(apps, 'getForegroundAppInfo').get('appId') == app:
                    break
                time.sleep(.25)
            else:
                raise RuntimeError(key + ': expected foreground app not observed')
            print('PASS ' + key, flush=True)
            time.sleep(1)
        observer = subprocess.Popen(['ssh', '-o', 'ConnectTimeout=5', tv.host,
                                     'python3 -c ' + shlex.quote(OBSERVE)],
                                    stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        if observer.stdout.readline().strip() != 'READY':
            raise RuntimeError('TV key observer did not start')
        send('media', 'play_pause', 'stop')
        output, _ = observer.communicate(timeout=15)
        events = json.loads(output)
        if events != [[164, 1], [164, 0], [128, 1], [128, 0]]:
            raise RuntimeError('Unexpected media key edges: ' + str(events))
        print('PASS Play/Pause toggle and Stop press/release reach TV input', flush=True)
    finally:
        if observer and observer.poll() is None:
            observer.terminate()
            observer.communicate(timeout=5)
        try:
            api(audio, 'setVolume', {'volume': before['volume']})
            api(audio, 'setMuted', {'muted': before['muteStatus']})
        finally:
            remote.ssh('systemctl start airmouse.service')


if __name__ == '__main__':
    main()
