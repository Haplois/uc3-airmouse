#!/usr/bin/env python3
"""Record decoded LG IR input events alongside an airmouse-lg-record capture."""
import argparse
import os
import pathlib
import re
import subprocess

RECORDER = r'''
import glob
import json
import os
import select
import struct
import sys
import time

devices = []
for entry in glob.glob('/sys/class/input/event*/device/name'):
    with open(entry) as source:
        if source.read().strip() == 'LGE RCU':
            devices.append('/dev/input/' + entry.split('/')[4])
if len(devices) != 1:
    raise RuntimeError('Expected exactly one LGE RCU input device')
event = struct.Struct('@llHHi')
fd = os.open(devices[0], os.O_RDONLY | os.O_NONBLOCK)
print(json.dumps({'device': devices[0], 'event_size': event.size}), flush=True)
print('CAPTURE_READY: decoded IR input for SECONDS seconds', file=sys.stderr, flush=True)
deadline = time.monotonic() + SECONDS
pending = b''
try:
    while time.monotonic() < deadline:
        if not select.select([fd], [], [], min(1, max(0, deadline-time.monotonic())))[0]:
            continue
        data = os.read(fd, event.size * 64)
        if not data:
            raise RuntimeError('Input device closed')
        pending += data
        while len(pending) >= event.size:
            sec, usec, kind, code, value = event.unpack(pending[:event.size])
            pending = pending[event.size:]
            print(json.dumps({'observed_ns': time.time_ns(), 'event_us': sec*1000000+usec,
                              'type': kind, 'code': code, 'value': value}), flush=True)
finally:
    os.close(fd)
print('CAPTURE_COMPLETE', file=sys.stderr, flush=True)
'''


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--host', default='root@lg-tv.example')
    parser.add_argument('--seconds', type=int, default=120)
    parser.add_argument('--output', type=pathlib.Path, required=True)
    args = parser.parse_args()
    if not re.fullmatch(r'[a-z_][a-z0-9_-]*@[A-Za-z0-9][A-Za-z0-9.-]*', args.host):
        parser.error('Expected user@host')
    if not 1 <= args.seconds <= 600:
        parser.error('Duration must be between 1 and 600 seconds')
    try:
        args.output.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        fd = os.open(args.output, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, 'wb') as output:
            subprocess.run(['ssh', '-o', 'BatchMode=yes', '-o', 'StrictHostKeyChecking=yes',
                            '-o', 'ConnectTimeout=8', '-o', 'ServerAliveInterval=10',
                            '-o', 'ServerAliveCountMax=2', args.host, 'python3 -u -'],
                           input=RECORDER.replace('SECONDS', str(args.seconds)).encode(),
                           stdout=output, check=True, timeout=args.seconds+30)
        print(f'Saved decoded input events to {args.output.resolve()}')
    except (OSError, subprocess.SubprocessError) as error:
        parser.exit(1, f'LG input recording failed; partial capture may remain at {args.output}: {error}\n')


if __name__ == '__main__':
    main()
