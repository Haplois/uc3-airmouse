#!/usr/bin/env python3
"""Verify Remote 3's negotiated TV link interval and latency after reconnection."""
import argparse
import json
from pathlib import Path
import re
import runpy
import subprocess

TRACE = r'''
import ctypes, json, select, socket, struct, time
class Address(ctypes.Structure):
    _fields_ = [('family', ctypes.c_ushort), ('device', ctypes.c_ushort), ('channel', ctypes.c_ushort)]
monitor = socket.socket(31, socket.SOCK_RAW, 1)
libc = ctypes.CDLL(None, use_errno=True)
address = Address(31, 0xffff, 2)
if libc.bind(monitor.fileno(), ctypes.byref(address), ctypes.sizeof(address)):
    raise OSError(ctypes.get_errno(), 'HCI monitor bind')
peer = bytes.fromhex(PEER.replace(':', ''))[::-1]
handles = set()
latest = None
print('READY', flush=True)
deadline = time.monotonic() + 30
while time.monotonic() < deadline:
    if not select.select([monitor], [], [], .5)[0]:
        continue
    packet = monitor.recv(65535)
    if len(packet) < 8:
        continue
    opcode, adapter, size = struct.unpack_from('<HHH', packet)
    event = packet[6:]
    if opcode != 3 or size != len(event) or event[1] != len(event) - 2:
        continue
    result = None
    if event[0] == 5 and len(event) == 6 and event[2] == 0:
        connection = (adapter, struct.unpack_from('<H', event, 3)[0])
        if connection in handles:
            handles.remove(connection)
            latest = None
            result = {'event': 'disconnected'}
    elif event[0] == 0x3e and len(event) >= 4:
        subevent, data = event[2], event[3:]
        if subevent in (1, 10) and len(data) == (18 if subevent == 1 else 30) and data[0] == 0:
            connection = (adapter, struct.unpack_from('<H', data, 1)[0])
            if connection in handles:
                handles.remove(connection)
                latest = None
            if data[3] == 0 and data[4] in (0, 1) and data[5:11] == peer:
                handles.add(connection)
                offset = 11 if subevent == 1 else 23
                interval, latency, timeout = struct.unpack_from('<3H', data, offset)
                latest = {'interval_ms': interval * 1.25, 'latency': latency, 'timeout_ms': timeout * 10}
                result = dict(latest, event='connected')
        elif subevent == 3 and len(data) == 9:
            connection = (adapter, struct.unpack_from('<H', data, 1)[0])
            if connection in handles:
                if data[0] == 0:
                    interval, latency, timeout = struct.unpack_from('<3H', data, 3)
                    latest = {'interval_ms': interval * 1.25, 'latency': latency, 'timeout_ms': timeout * 10}
                    result = dict(latest, event='updated')
                else:
                    result = {'event': 'update_failed', 'status': data[0]}
    if result:
        print(json.dumps(result), flush=True)
monitor.close()
print(json.dumps({'final': latest}), flush=True)
'''


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--tv', required=True, help='root@TV-host, already on')
    parser.add_argument('--remote', required=True, help='root@Remote-3-host')
    parser.add_argument('--address', required=True, help='Remote 3 Bluetooth address')
    parser.add_argument('--reconnect', action='store_true', required=True,
                        help='Restart Remote 3 Bluetooth to observe a fresh link')
    args = parser.parse_args()
    if not re.fullmatch(r'(?:[0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}', args.address):
        parser.error('Expected a Bluetooth MAC address')
    module = runpy.run_path(str(Path(__file__).with_name('airmouse-lg-deploy-receiver')))
    tv, remote = module['TV'](args.tv), module['TV'](args.remote)
    ssh = ['ssh', '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=5',
           '-o', 'ServerAliveInterval=5', '-o', 'ServerAliveCountMax=2']
    process = subprocess.Popen([*ssh, tv.host, 'python3 -u -'], stdin=subprocess.PIPE,
                               stdout=subprocess.PIPE, text=True)
    try:
        process.stdin.write('PEER = ' + repr(args.address) + '\n' + TRACE)
        process.stdin.close()
        if process.stdout.readline().strip() != 'READY':
            raise ValueError('TV monitor did not start')
        remote.ssh('systemctl restart airmouse-bluetooth.service')
        final = None
        for line in process.stdout:
            result = json.loads(line)
            print(json.dumps(result), flush=True)
            if 'final' in result:
                final = result['final']
        process.wait(timeout=5)
        if process.returncode or not final or final['interval_ms'] != 10 or final['latency'] != 0:
            raise ValueError('TV did not retain a 10 ms link with zero peripheral latency')
        print('Fresh connection retained 10 ms and zero peripheral latency.')
    finally:
        if process.poll() is None:
            process.terminate()
            process.wait(timeout=5)


if __name__ == '__main__':
    main()
