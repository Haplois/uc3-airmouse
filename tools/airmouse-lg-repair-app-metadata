#!/usr/bin/env python3
"""Check, or quarantine, stale Netflix/YouTube overlay metadata on the lab TV.

Apply closes both apps, unmounts only their overlays, and preserves metadata in
a timestamped backup. Reboot the TV after applying so its app registry refreshes.
Account data and installed packages are not changed.
"""
import argparse
from pathlib import Path
import runpy

REMOTE = r'''
import hashlib, json, os, pathlib, shutil, subprocess, sys, tempfile, time
sys.path.insert(0, '/var/lib/webosbrew/airmouse-lg-receiver')
from startup import api
APPS = ('netflix', 'youtube.leanback.v4')
UPPER = pathlib.Path('/media/data/data')
BASE = pathlib.Path('/media/cryptofs/apps/usr/palm/applications')
def mounts(app):
    return [line.split()[1] for line in pathlib.Path('/proc/mounts').read_text().splitlines()
            if line.split()[2] == 'overlay'
            and 'upperdir=' + str(UPPER / app) in line.split()[3].split(',')]
audit = []
with tempfile.TemporaryDirectory(prefix='airmouse-app-base-') as temporary:
    subprocess.run(['mount', '--bind', str(BASE), temporary], check=True)
    try:
        for app in APPS:
            original = json.loads((pathlib.Path(temporary) / app / 'appinfo.json').read_text())
            override = UPPER / app / 'appinfo.json'
            effective = json.loads(override.read_text()) if override.exists() else original
            if original.get('id') != app or effective.get('id') != app:
                raise RuntimeError('Unexpected application identity')
            differences = {key: [effective.get(key), original.get(key)]
                           for key in original.keys() | effective.keys()
                           if effective.get(key) != original.get(key)}
            audit.append({'app': app, 'installed_version': original['version'],
                          'exposed_version': effective['version'], 'differences': differences,
                          'override_sha256': hashlib.sha256(override.read_bytes()).hexdigest()
                          if override.exists() else None})
    finally:
        subprocess.run(['umount', temporary], check=True)
print(json.dumps({'audit': audit}), flush=True)
stale = [item for item in audit if item['differences']]
if not APPLY:
    sys.exit(1 if stale else 0)
if not stale:
    print('No stale metadata overrides; nothing changed.')
    sys.exit(0)
allowed = {'version', 'trustLevel', 'extraLargeIcon', 'mediumLargeIcon', 'bgImage',
           'binId', 'appsize', 'previewMetadata'}
if any(set(item['differences']) - allowed for item in stale):
    raise RuntimeError('Unexpected override fields; refusing automatic repair')
backup = pathlib.Path('/var/lib/webosbrew') / ('app-metadata-backup-' + str(time.time_ns()))
backup.mkdir(mode=0o700)
(backup / 'audit.json').write_text(json.dumps(audit, indent=2))
for app in APPS:
    api('closeByAppId', {'id': app}, service='com.webos.service.applicationmanager')
time.sleep(1)
for item in stale:
    app = item['app']
    for target in sorted(mounts(app), key=len, reverse=True):
        if target in mounts(app):
            subprocess.run(['umount', target], check=True)
    if mounts(app):
        raise RuntimeError('Application overlay still mounted; no metadata removed')
    source = UPPER / app / 'appinfo.json'
    if hashlib.sha256(source.read_bytes()).hexdigest() != item['override_sha256']:
        raise RuntimeError('Override changed since audit')
    saved = backup / (app + '.appinfo.json')
    shutil.copy2(source, saved)
    if hashlib.sha256(saved.read_bytes()).hexdigest() != item['override_sha256']:
        raise RuntimeError('Metadata backup verification failed')
    source.unlink()
hook = pathlib.Path('/var/lib/webosbrew/init.d/90-repair-youtube-icons')
if hook.exists():
    shutil.move(str(hook), str(backup / hook.name))
os.sync()
print(json.dumps({'backup': str(backup), 'quarantined': [item['app'] for item in stale],
                  'reboot_required': True}), flush=True)
'''

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--tv', required=True)
    parser.add_argument('--apply', action='store_true')
    args = parser.parse_args()
    TV = runpy.run_path(str(Path(__file__).with_name('airmouse-lg-deploy-receiver')))['TV']
    import subprocess
    try:
        print(TV(args.tv).ssh('python3 -', data=REMOTE.replace('APPLY', repr(args.apply)).encode()))
    except subprocess.CalledProcessError as error:
        print(error.stdout.decode())
        print(error.stderr.decode())
        raise SystemExit(error.returncode)

if __name__ == '__main__':
    main()
