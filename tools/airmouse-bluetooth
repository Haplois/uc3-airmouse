#!/usr/bin/env python3
"""Install and control reversible Bluetooth ownership over authorized SSH."""
import argparse
import gzip
import hashlib
import json
import pathlib
import re
import shlex
import subprocess
import tarfile

ROOT = pathlib.Path(__file__).resolve().parent.parent
BASE = '/mnt/data/airmouse/bluetooth'

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--host', default='root@10.0.10.51')
    parser.add_argument('command', choices=['install', 'probe', 'takeover', 'rollback', 'status', 'recover-subscriptions'])
    parser.add_argument('--archive', type=pathlib.Path, help='ARM64 bundle from airmouse-bluetooth-build')
    parser.add_argument('--backup', help='On-device bonds.tlv backup for subscription recovery')
    parser.add_argument('--apply', action='store_true', help='Apply subscription recovery; default is dry-run')
    args = parser.parse_args()
    if not re.fullmatch(r'root@[A-Za-z0-9][A-Za-z0-9.-]*', args.host):
        parser.error('Expected root@host with a hostname or IPv4 address')
    if args.command == 'install' and not args.archive:
        parser.error('install requires --archive')
    if args.command != 'install' and args.archive:
        parser.error('--archive applies only to install')
    if args.command == 'recover-subscriptions' and not args.backup:
        parser.error('recover-subscriptions requires --backup')
    if args.command != 'recover-subscriptions' and (args.backup or args.apply):
        parser.error('--backup and --apply apply only to recover-subscriptions')
    ssh = ['ssh', '-o', 'BatchMode=yes', '-o', 'StrictHostKeyChecking=yes', '-o', 'ConnectTimeout=8', args.host]
    def remote(*command, data=None):
        subprocess.run(ssh + [shlex.join(command)], input=data, check=True)
    if args.command == 'recover-subscriptions':
        remote('flock', '-n', f'{BASE}/state/owner.lock', 'node', '--input-type=module', '-',
               f'{BASE}/state', args.backup, 'apply' if args.apply else 'dry-run',
               data=(ROOT / 'bluetooth/recover-subscriptions.mjs').read_bytes())
    elif args.command == 'install':
        with tarfile.open(args.archive) as tar:
            members = tar.getmembers()
            for member in members:
                path = pathlib.PurePosixPath(member.name)
                if not member.isfile() or path.is_absolute() or '..' in path.parts:
                    parser.error('Bundle contains an unsafe archive member')
            manifest = json.load(tar.extractfile('build.json'))
            if manifest.get('arch') != 'arm64':
                parser.error('Only ARM64 bundles can be installed on the remote')
            binary = tar.extractfile('bin/airmouse-hid').read()
            if hashlib.sha256(binary).hexdigest() != manifest.get('binary_sha256'):
                parser.error('Daemon checksum does not match build.json')
        data = args.archive.read_bytes()
        release = hashlib.sha256(data).hexdigest()[:16]
        destination = f'{BASE}/releases/{release}'
        remote('mkdir', '-p', destination)
        remote('tar', '-x', '-f', '-', '-C', destination, data=gzip.decompress(data))
        remote('sh', f'{destination}/deploy/owned-bluetooth.sh', 'install', release)
    else:
        remote('sh', f'{BASE}/owned-bluetooth.sh', args.command)

if __name__ == '__main__':
    main()
